<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane prefHeight="500.0" prefWidth="700.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.MainController">
   <children>
      <Label layoutX="197.0" layoutY="84.0" rotate="-10.0" styleClass="name-label" text="Christopher Gonzalez" />
      <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="276.0" layoutY="272.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Button.png" />
         </image>
      </ImageView>
      <Button fx:id="myButton" layoutX="324.0" layoutY="197.0" mnemonicParsing="false" onAction="#handleButtonClick" text="Click Me!" />
      <Label fx:id="messageLabel" layoutX="296.0" layoutY="165.0" text="Dont Click The Button!" />
   </children>
</AnchorPane>
